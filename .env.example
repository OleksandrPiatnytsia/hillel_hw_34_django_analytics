# Copy to .env and fill in real values: cp .env.example .env
# Generate a key (works before "pip install" too): python -c "import secrets; print(secrets.token_urlsafe(50))"
# Keep the key in SINGLE quotes: it may contain "$", and docker compose
# would treat $abc as a variable inside double quotes or without quotes.
DJANGO_SECRET_KEY='change-me'
# Read only by the development settings (runserver on your machine); the
# production settings (Docker, Railway) always have DEBUG off.
DJANGO_DEBUG=True
# Host names of the service, comma separated. Required by the production settings.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production settings only: HTTPS redirect, secure cookies, HSTS.
# docker-compose.yml sets False (http://localhost:8010 has no certificate).
# DJANGO_HTTPS=True

# PostgreSQL of Analytics (its own one, not the bookstore's). The postgres
# container creates this database and user on its first start.
# On a hosting one variable instead of these five: DATABASE_URL=postgresql://...
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me
# localhost:5433 for runserver and pytest on the Mac (5432 is the
# bookstore's); docker-compose.yml uses db:5432 inside the Docker network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis of Analytics: database 0 = cache + sessions, database 1 = the
# Celery queue. 6380 on the Mac (6379 is the bookstore's);
# docker-compose.yml uses redis://redis:6379 inside the Docker network.
REDIS_URL=redis://localhost:6380

# RabbitMQ of the bookstore (its docker compose): the same login as
# RABBITMQ_USER / RABBITMQ_PASSWORD in the bookstore's .env.
# localhost:5672 for runserver / manage.py on the Mac; docker-compose.yml
# uses rabbitmq:5672 inside the bookstore's network.
# On a hosting one variable instead: RABBITMQ_URL=amqp://user:password@host:5672//
RABBITMQ_USER=bookstore
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Sentry: the DSN of the Analytics project (a separate project from the
# bookstore): Settings -> Projects -> <project> -> Client Keys (DSN).
# Empty -> Sentry is off.
SENTRY_DSN=
# "local" for runserver; docker-compose.yml sets "docker"
SENTRY_ENVIRONMENT=local
# Part of the requests timed in Sentry -> Performance (0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=0.1
